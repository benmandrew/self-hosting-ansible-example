# Redirect www to the apex domain.
server {
    listen 80;
    listen 443 ssl;
    server_name www.{{ domain }};

    ssl_certificate /etc/ssl/certs/origin.pem;
    ssl_certificate_key /etc/ssl/certs/origin.key;

    return 301 https://{{ domain }}$request_uri;
}

# Redirect HTTP to HTTPS.
server {
    listen 80;
    server_name {{ domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ domain }};

    ssl_certificate /etc/ssl/certs/origin.pem;
    ssl_certificate_key /etc/ssl/certs/origin.key;

    root /var/www/site;
    index index.html;
    charset utf-8;
    error_page 404 /404.html;

    location / {
        # /about serves about.html, so links need no extension.
        try_files $uri $uri.html $uri/ =404;
    }
}
